From db41ebaf0486e9903745c46a59fed9ccc4d5938b Mon Sep 17 00:00:00 2001
From: Bernhard Voelker <mail@bernhard-voelker.de>
Date: Sat, 8 Aug 2026 17:48:52 +0200
Subject: [PATCH] updatedb: prefer runuser(1) over su(1)

The manpage of su(1) suggests better using runuser(1) in cases where
the invoking process is already privileged.

* locate/updatedb.sh (updatedbuserchange): Add shell variable and set it
to 'runuser' if which(1) finds it (via PATH).  Use  this variable in the
main code and in the select_shell function.

Suggested by Andreas Metzler in
  https://sv.gnu.org/bugs/?68587
---
 NEWS               |  5 +++++
 doc/find.texi      |  8 +++++---
 locate/updatedb.1  |  8 +++++---
 locate/updatedb.sh | 18 ++++++++++++------
 4 files changed, 27 insertions(+), 12 deletions(-)

--- a/NEWS
+++ b/NEWS
@@ -1,7 +1,15 @@
 GNU findutils NEWS - User visible changes.      -*- outline -*- (allout)
 
+* Noteworthy changes in release ?.? (????-??-??) [?]
+
+** Improvements
+
+  The updatedb script now prefers the runuser(1) tool over su(1) if the former
+  is installed.
+
+
 * Noteworthy changes in release 4.11.0 (2026-07-11) [stable]
 
 ** Bug Fixes
 
   find no longer crashes when diagnosing a directory cycle (without a symlink
--- a/doc/find.texi
+++ b/doc/find.texi
@@ -3942,17 +3942,19 @@ is @file{nfs NFS proc}.
 @item --output=@var{dbfile}
 The database file to build.  The default is system-dependent, but
 when this document was formatted it was @file{@value{LOCATE_DB}}.
 
 @item --localuser=@var{user}
-The user to search the non-network directories as, using @code{su}.
+The user to search the non-network directories as, using @code{runuser} or
+@code{su}, preferring the former.
 Default is to search the non-network directories as the current user.
 You can also use the environment variable @env{LOCALUSER} to set this user.
 
 @item --netuser=@var{user}
-The user to search network directories as, using @code{su}.  Default
-@code{user} is @code{daemon}.  You can also use the environment variable
+The user to search network directories as, using @code{runuser} or
+@code{su}, preferring the former.
+Default @var{user} is @code{daemon}.  You can also use the environment variable
 @env{NETUSER} to set this user.
 
 @item --dbformat=@var{FORMAT}
 Generate the locate database in format @code{FORMAT}.  Supported
 database formats include @code{LOCATE02} (which is the default) and
--- a/locate/updatedb.1
+++ b/locate/updatedb.1
@@ -83,17 +83,19 @@ Default is \fInfs NFS proc\fP.
 The database file to build.
 Default is system-dependent.  In Debian GNU/Linux, the default
 is /var/cache/locate/locatedb.
 .TP
 .B \-\-localuser=\fIuser\fP
-The user to search non-network directories as, using \fBsu\fP(1).
+The user to search non-network directories as, using \fBrunuser\fP(1) or
+\fBsu\fP(1), preferring the former.
 Default is to search the non-network directories as the current user.
 You can also use the environment variable \fBLOCALUSER\fP to set this user.
 .TP
 .B \-\-netuser=\fIuser\fP
-The user to search network directories as, using \fBsu\fP(1).
-Default is \fBdaemon\fP.
+The user to search network directories as, using \fBrunuser\fP(1) or
+\fBsu\fP(1), preferring the former.
+Default user is \fBdaemon\fP.
 You can also use the environment variable \fBNETUSER\fP to set this user.
 .TP
 .B \-\-dbformat=F
 Create the database in format F.  The default format is called LOCATE02.
 Alternatively the
--- a/locate/updatedb.sh
+++ b/locate/updatedb.sh
@@ -121,21 +121,21 @@ getuid() {
     # uid=1(daemon) gid=1(other)
     # for `id's that don't understand -u
     id | cut -d'(' -f 1 | cut -d'=' -f2
 }
 
-# figure out if su supports the -s option
+# figure out if the switch-user tool supports the -s option
 select_shell() {
-    if su "$1" -s $SHELL -c false < /dev/null  ; then
+    if $updatedbuserchange "$1" -s $SHELL -c false < /dev/null  ; then
 	# No.
 	echo ""
     else
-	if su "$1" -s $SHELL -c true < /dev/null  ; then
+	if $updatedbuserchange "$1" -s $SHELL -c true < /dev/null  ; then
 	    # Yes.
 	    echo "-s $SHELL"
         else
-	    # su is unconditionally failing.  We won't be able to
+	    # Unconditional failure.  We won't be able to
 	    # figure out what is wrong, so be conservative.
 	    echo ""
 	fi
     fi
 }
@@ -280,10 +280,16 @@ prunefs_exp=`echo $PRUNEFS |sed -e 's/\(
  -e 's/-o //' -e 's/$/ -o/'`
 else
   prunefs_exp=''
 fi
 
+if which runuser >/dev/null 2>&1; then
+    updatedbuserchange=runuser
+else
+    updatedbuserchange=su
+fi
+
 # Make and code the file list.
 # Sort case insensitively for users' convenience.
 
 rm -f $LOCATE_DB.n
 trap 'rm -f $LOCATE_DB.n; exit' HUP TERM
@@ -291,11 +297,11 @@ trap 'rm -f $LOCATE_DB.n; exit' HUP TERM
 if {
 cd "$changeto"
 if test -n "$SEARCHPATHS"; then
   if [ "$LOCALUSER" != "" ]; then
     # : A1
-    su $LOCALUSER `select_shell $LOCALUSER` -c \
+    $updatedbuserchange $LOCALUSER `select_shell $LOCALUSER` -c \
     "$find $SEARCHPATHS $FINDOPTIONS \
      \\( $prunefs_exp \
      -type d -regex '$PRUNEREGEX' \\) -prune -o $print_option"
   else
     # : A2
@@ -307,11 +313,11 @@ fi
 
 if test -n "$NETPATHS"; then
 myuid=`getuid`
 if [ "$myuid" = 0 ]; then
     # : A3
-    su $NETUSER `select_shell $NETUSER` -c \
+    $updatedbuserchange $NETUSER `select_shell $NETUSER` -c \
      "$find $NETPATHS $FINDOPTIONS \\( -type d -regex '$PRUNEREGEX' -prune \\) -o $print_option" ||
     exit $?
   else
     # : A4
     $find $NETPATHS $FINDOPTIONS \( -type d -regex "$PRUNEREGEX" -prune \) -o $print_option ||
