#!/bin/sh
# plain-ext4 assembly script.
#   $1  path to the rootfs tarball (read-only)
#   $2  path to write the finished ext4 disk image to
#
# No loop device is available, so the filesystem is populated directly from an
# extracted directory tree with `mke2fs -d`, which needs no mount.
#
# The image is reproducible: the patched mke2fs (from the e2fsprogs tooling
# package, overlaid over the mirror copy) is driven entirely by explicit inputs
# so the output is a pure function of the rootfs tarball. Every non-deterministic
# input mke2fs would otherwise invent is pinned here:
#   - SOURCE_DATE_EPOCH  : the single timestamp stamped on the superblock and,
#                          with the reproducible-inode-times patch, forced onto
#                          every inode's a/c/m/crtime (not clamped). Fixed at 0.
#   - -U <uuid>          : the filesystem UUID (also seeds every metadata csum),
#                          derived from the image identity.
#   - hash_seed=<uuid>   : the directory HTREE hash seed, derived from the image
#                          identity.
#   - hash_sign=unsigned : the directory-hash signedness, pinned independent of
#                          the build host's architecture (the explicit-dirhash-
#                          signedness patch); unsigned is the arm/aarch64 value
#                          and is chosen unconditionally so every arch agrees.
# Identifiers are derived from $GLBX_IMAGE_ID, which glbx sets to the image's
# content identity; the image already folds the rootfs and this script, so
# deriving from it makes every identifier a pure function of the same inputs.
set -eu

rootfs_tar="$1"
out="$2"

: "${GLBX_IMAGE_ID:?GLBX_IMAGE_ID must be set by glbx}"

# uuid_hash reads stdin, SHA-256s it, and formats the first 16 bytes (32 hex
# chars) as a UUID — the same derivation Garden Linux uses for reproducible ids.
uuid_hash() {
	sha256sum \
		| cut -d' ' -f1 \
		| sed -E 's/^(.{8})(.{4})(.{4})(.{4})(.{12}).*/\1-\2-\3-\4-\5/'
}

export SOURCE_DATE_EPOCH=0

uuid="$(printf '%s:fs_uuid' "$GLBX_IMAGE_ID" | uuid_hash)"
hash_seed="$(printf '%s:hash_seed' "$GLBX_IMAGE_ID" | uuid_hash)"

workdir="$(mktemp -d)"
tar -xf "$rootfs_tar" -C "$workdir"

# Size the image to the extracted tree plus generous slack, rounded to MiB.
used_kib="$(du -sk "$workdir" | cut -f1)"
size_mib=$(( (used_kib / 1024) + 64 ))

mke2fs -q -F -t ext4 -b 4096 -I 256 \
	-U "$uuid" \
	-E "hash_seed=$hash_seed,hash_sign=unsigned" \
	-d "$workdir" \
	"$out" "${size_mib}M"

rm -rf "$workdir"
