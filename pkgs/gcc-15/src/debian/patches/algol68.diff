+            a1[i] := 3;
+            a2[i,j] := 3;
+            a3[i] := 3;
+            a4[i,j] := 3;
+            a5[i,j,k] := 3;
+            a6[i,j,k,l] := 3;
+            BEGIN REF REF REF REF REF REF REF REF REF REF
+                  REF REF REF REF REF REF REF REF REF REF
+                  []REAL x;
+                  x[i] := 3.0
+            END
+      END
+END
