+
+# Documentation.
+
+A68_MANUAL_FILES =
+
+A68_MANUAL_FILES = \
+		algol68/ga68.texi \
+		$(gcc_docdir)/include/fdl.texi \
+		$(gcc_docdir)/include/gpl_v3.texi \
+		$(gcc_docdir)/include/gcc-common.texi \
+		gcc-vers.texi
+
+A68_INT_MANUAL_FILES = \
+		algol68/ga68-internals.texi \
+		$(gcc_docdir)/include/fdl.texi \
+		$(gcc_docdir)/include/gcc-common.texi \
+		gcc-vers.texi
