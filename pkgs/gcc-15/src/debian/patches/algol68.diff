+        (a[17]+(a[18]+(a[19]+(a[20])))))))))))))))))))-9.0;
+    putr(2, 1.0, x)
+END;
+
+BEGIN
+
+    [1:10]INT a;
+
+    FOR i FROM 1 BY 1 TO 9 DO a[i]:=i+1 OD;
+    a[10]:=1;
+
+    FOR i FROM 1 BY 1 TO 10
+    DO puti(3, i, a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[i
+            ]]]]]]]]]]]]]]]]]]]]
+        )
