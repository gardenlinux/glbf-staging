From: =?utf-8?q?Christian_G=C3=B6ttsche?= <cgzones@googlemail.com>
Date: Sat, 11 Jul 2026 11:56:13 +0200
Subject: Do not use 64-bit atomics on architectures lacking them

Keep the lock-free fast path where the target supports it and fall back
to the previous mutex guarded increment where it does not. Avoid a
libatomic depedency.

Forwarded: not-needed
---
 src/selinux_restorecon.c | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/src/selinux_restorecon.c b/src/selinux_restorecon.c
index b34d8e6..2a3746d 100644
--- a/src/selinux_restorecon.c
+++ b/src/selinux_restorecon.c
@@ -18,6 +18,7 @@
 #include <dirent.h>
 #include <inttypes.h>
 #include <limits.h>
+#include <stdatomic.h>
 #include <stdint.h>
 #include <sys/types.h>
 #include <sys/stat.h>
@@ -61,6 +62,23 @@ static uint64_t fc_count = 0; /* Number of files processed so far */
 static uint64_t efile_count; /* Estimated total number of files */
 static pthread_mutex_t progress_mutex = PTHREAD_MUTEX_INITIALIZER;
 
+static inline uint64_t fc_count_inc(void)
+{
+#if ATOMIC_LLONG_LOCK_FREE == 2
+	return __atomic_add_fetch(&fc_count, 1, __ATOMIC_RELAXED);
+#else
+	/* Architectures without lock-free 64-bit atomics, e.g. 32-bit powerpc,
+	 * would otherwise need to link against libatomic. */
+	uint64_t count;
+
+	__pthread_mutex_lock(&progress_mutex);
+	count = ++fc_count;
+	__pthread_mutex_unlock(&progress_mutex);
+
+	return count;
+#endif
+}
+
 /* Store information on directories with xattr's. */
 static struct dir_xattr *dir_xattr_list;
 static struct dir_xattr *dir_xattr_last;
@@ -754,8 +772,7 @@ static int restorecon_sb(int fd, const char *pathname, const struct stat *sb,
 		const unsigned STAR_COUNT = 1024;
 		uint64_t fc_count_local;
 
-		fc_count_local =
-			__atomic_add_fetch(&fc_count, 1, __ATOMIC_RELAXED);
+		fc_count_local = fc_count_inc();
 
 		if (fc_count_local % STAR_COUNT == 0) {
 			__pthread_mutex_lock(&progress_mutex);
