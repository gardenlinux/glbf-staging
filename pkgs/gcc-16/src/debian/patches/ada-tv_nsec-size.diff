# DP: https://bugs.debian.org/1108322

PR ada/114065 version 22 patch 3/4

--- a/src/gcc/ada/s-oscons-tmplt.c
+++ b/src/gcc/ada/s-oscons-tmplt.c
@@ -1771,7 +1771,14 @@ CNS(MAX_tv_sec, "")
    --  Sizes (in bytes) of the components of struct timespec.
    --  The tv_sec field is the same as in struct timeval.
 */
+#ifdef __GLIBC__
+   // https://sourceware.org/glibc/wiki/Y2038ProofnessDesign#struct_timespec
+   // On glibc, this should be equivalent to sizeof(ts.tv_nsec),
+   // but ensures that the sizes of the Ada record and C struct match.
+#  define SIZEOF_tv_nsec (sizeof (ts) - sizeof (ts.tv_sec))
+#else
 #define SIZEOF_tv_nsec (sizeof (ts.tv_nsec))
+#endif
 CND(SIZEOF_tv_nsec, "tv_nsec");
 }
 
