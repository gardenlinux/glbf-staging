#!/bin/bash
set -e

# Empty /etc/machine-id so systemd provisions a unique id on first boot. An empty
# file (rather than an absent one) lets a read-only image bind-mount a temporary
# id over it.
: > /etc/machine-id

# ldconfig's aux-cache records inode/mtime-keyed library metadata that varies run
# to run. It is a pure cache, regenerated by the boot-time ldconfig run.
rm -f /var/cache/ldconfig/aux-cache
